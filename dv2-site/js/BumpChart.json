{
  "width": "container",
  "height": 480,
  "title": {
    "text": "Which industries employ the most people? Rank over 36 years",
    "subtitle": "1 = largest industry. Coloured lines are the biggest movers.",
    "anchor": "start",
    "fontSize": 15
  },
  "data": {
    "url": "data/employment_by_industry_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "trend": "number",
        "date": "date"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.industry != 'All industries'"
    },
    {
      "filter": "utcmonth(datum.date) == 1 && ((utcyear(datum.date) >= 1990 && utcyear(datum.date) % 5 == 0) || utcyear(datum.date) == 2026)"
    },
    {
      "calculate": "utcyear(datum.date)",
      "as": "yr"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "groupby": [
        "yr"
      ],
      "sort": [
        {
          "field": "trend",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "indexof([\"Health Care and Social Assistance\", \"Professional, Scientific and Technical Services\", \"Construction\", \"Education and Training\", \"Retail Trade\", \"Manufacturing\", \"Agriculture, Forestry and Fishing\"], datum.industry) >= 0 ? datum.industry : 'Other'",
      "as": "grp"
    }
  ],
  "encoding": {
    "x": {
      "field": "yr",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "reverse": true,
        "domain": [
          0.5,
          19.5
        ]
      },
      "axis": {
        "title": "Rank",
        "tickMinStep": 1,
        "grid": false
      }
    },
    "color": {
      "field": "grp",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Health Care and Social Assistance",
          "Professional, Scientific and Technical Services",
          "Construction",
          "Education and Training",
          "Retail Trade",
          "Manufacturing",
          "Agriculture, Forestry and Fishing",
          "Other"
        ],
        "range": [
          "#1f6f8b",
          "#6a4c93",
          "#e08a1e",
          "#3a9d6e",
          "#c4572b",
          "#8c6d4f",
          "#b5a642",
          "#c9c6bc"
        ]
      }
    },
    "opacity": {
      "condition": {
        "test": "datum.grp != 'Other'",
        "value": 1
      },
      "value": 0.55
    },
    "detail": {
      "field": "industry",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 55
      },
      "encoding": {
        "tooltip": [
          {
            "field": "industry",
            "title": "Industry"
          },
          {
            "field": "yr",
            "title": "Year"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "trend",
            "title": "Employed (thousands)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == 2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 10.5
      },
      "encoding": {
        "text": {
          "field": "industry"
        },
        "color": {
          "value": "#1d2a33"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "padding": {
    "right": 210
  }
}